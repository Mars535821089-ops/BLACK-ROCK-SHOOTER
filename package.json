{
  "name": "codex-blueflame-pet",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --exclude tests/preview.spec.ts",
    "typecheck": "tsc --noEmit",
    "build:pet": "tsx src/cli.ts build",
    "validate:pet": "tsx src/cli.ts validate",
    "install:pet": "tsx src/cli.ts install",
    "capture:evidence": "tsx src/cli.ts contact-sheet && playwright test tests/preview.spec.ts --grep \"captures every state at the native review sizes\"",
    "preview": "vite --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
